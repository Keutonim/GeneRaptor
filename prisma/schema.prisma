// GeneRaptor Prisma schema (19 исходных моделей -> 8 на SQLite, M1).
//
// Trimmed from the original PostgreSQL schema:
//   - STRIPPED (crawl/publish/auto-gen/wordstat trees): SourceSite, Service,
//     Specialist, SpecialistService, Regulation, Platform, Publication,
//     AutoPublishSlot, AutoPublishSettings, AutoGenerationSettings,
//     AutoGenerationRun, IntegrationToken.
//   - SQLite type gaps: no @db.* annotations, no Json columns (metadata and
//     provider tier-model maps are JSON strings parsed in app code), no
//     String[] scalar lists. Decimal is supported by Prisma on SQLite.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Article — the hub. Trimmed vs the original: crawl FKs (serviceId/specialistId/
// sourceSiteId), wordstat columns, all 14 publish columns, autoGenerated and
// coverMediaId (WP attachment id) are GONE. Cover metadata columns stay —
// they feed the local cover store (M5).
model Article {
  id        String  @id @default(uuid())
  topic     String
  targetLength Int  @map("target_length")
  // Reason the worker persisted needs_review (wall-clock budget, QC
  // exhaustion, postcheck-enforce). NULL = not in needs_review.
  needsReviewReason String? @map("needs_review_reason")
  // Optional owner clarifications (trim, <=1000 chars) injected into the
  // author prompt as an isolated block. NULL = none.
  userNotes  String? @map("user_notes")
  // D6: material language of the article — a
  // generation parameter sent with the create request, stored with the
  // article and threaded into the role pipeline prompts. 'ru' | 'en'.
  language   String  @default("ru")
  // Cover binding (metadata only — never written together with status).
  coverUrl         String?   @map("cover_url")
  // M5: the cover binary is a file under <data-dir>/covers/;
  // the DB keeps the FILE REFERENCE (never a remote URL).
  coverFile        String?   @map("cover_file")
  coverModel       String?   @map("cover_model") // provider model id
  coverPrompt      String?   @map("cover_prompt")
  coverCostRub     Decimal?  @map("cover_cost_rub")
  coverGeneratedAt DateTime? @map("cover_generated_at")
  // The owner asked for a cover on THIS run; consumed (reset) by any
  // terminal cover outcome — no auto-retry, no double spend.
  coverRequested Boolean @default(false) @map("cover_requested")
  // Cover phase channel: requested | generating | ready | skipped | failed
  // | NULL (no cover request ever).
  coverStatus     String? @map("cover_status")
  // Machine code of the skip/fail reason; written only by the post-finalize
  // hook / the /start idempotency branch.
  coverSkipReason String? @map("cover_skip_reason")
  status     String  @default("draft")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  versions        ArticleVersion[]
  agentRuns       AgentRun[]
  researchSources ResearchSource[]

  @@map("article")
}

// ArticleVersion — the 3-format export source (contentHtml/Text/Markdown).
model ArticleVersion {
  id              String   @id @default(uuid())
  articleId       String   @map("article_id")
  version         Int
  platform        String
  title           String?
  description     String?
  contentHtml     String?  @map("content_html")
  contentText     String?  @map("content_text")
  contentMarkdown String?  @map("content_markdown")
  characterCount  Int?     @map("character_count")
  createdAt       DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@map("article_version")
}

// AgentRun — per-role ledger powering the details view and diagnostics.
model AgentRun {
  id           String    @id @default(uuid())
  articleId    String?   @map("article_id")
  agentName    String    @map("agent_name")
  status       String    @default("pending")
  progress     Int       @default(0)
  inputJson    String?   @map("input_json")
  outputJson   String?   @map("output_json")
  error        String?
  inputTokens  Int?      @map("input_tokens")
  outputTokens Int?      @map("output_tokens")
  costRub      Decimal?  @map("cost_rub")
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")

  article Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)

  @@index([articleId])
  @@map("agent_run")
}

// CoverSettings — single-row convention. Written only via the settings API;
// read by the cover service (M5).
model CoverSettings {
  id               String   @id @default(uuid())
  enabled          Boolean  @default(true)
  model            String   @default("qwen/qwen-image-2.1-pro")
  compressionModel String?  @map("compression_model") // nullable = inherit the standard tier model
  promptTemplate   String   @map("prompt_template")
  aspectRatio      String   @default("16:9") @map("aspect_ratio")
  resolution       String   @default("1K")
  quality          String   @default("high")
  outputFormat     String   @default("png") @map("output_format")
  autoGenerate     Boolean  @default(false) @map("auto_generate")
  monthlyCapRub    Decimal  @default(300) @map("monthly_cap_rub")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("cover_settings")
}

// AgentRoleSetting — per-role systemPrompt overrides (one row per role;
// absence = use the catalog in server/agent-role-data.mjs).
model AgentRoleSetting {
  id           String   @id @default(uuid())
  roleId       String   @unique @map("role_id")
  systemPrompt String   @map("system_prompt")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("agent_role_settings")
}

// ResearchSource — evidence layer (Director decision: KEEP). metadata was
// Json on PostgreSQL; SQLite has no Json type, so it is a JSON-encoded
// string parsed at the app boundary.
model ResearchSource {
  id            String    @id @default(uuid())
  articleId     String?   @map("article_id")
  provider      String
  query         String?
  sourceUrl     String?   @map("source_url")
  normalizedUrl String?   @map("normalized_url")
  title         String?
  snippet       String?
  extractedText String?   @map("extracted_text")
  evidenceLevel String    @default("medium") @map("evidence_level")
  publishedAt   DateTime? @map("published_at")
  fetchedAt     DateTime  @default(now()) @map("fetched_at")
  metadata      String?

  article Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)

  // One canonical source URL per (article, provider).
  @@unique([articleId, normalizedUrl, provider])
  @@index([articleId, provider])
  @@map("research_source")
}

// CompanyProfile — reduced to an optional single-row "author profile"
// feeding the author-signature prompt block (open item O2, default
// keep-minimal; no crawl FK anymore).
model CompanyProfile {
  id         String    @id @default(uuid())
  name       String?
  phone      String?
  email      String?
  address    String?
  licenses   String?
  parsedText String?   @map("parsed_text")
  editedText String?   @map("edited_text")
  activeText String?   @map("active_text")
  parsedAt   DateTime? @map("parsed_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@map("company_profile")
}

// ProviderConfig — one row per configured LLM provider (wired up in
// M3). kinds: routerai | openrouter | ollama | custom. modelsJson holds the
// tier->model assignments + cover model as a JSON-encoded string (SQLite has
// no Json type). apiKey stays local (never returned to the client); env
// fallback preserved for CI/headless.
model ProviderConfig {
  id         String   @id @default(uuid())
  kind       String // 'routerai' | 'openrouter' | 'ollama' | 'custom'
  baseUrl    String?  @map("base_url")
  apiKey     String?  @map("api_key")
  enabled    Boolean  @default(false)
  modelsJson String?  @map("models_json")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("provider_config")
}
