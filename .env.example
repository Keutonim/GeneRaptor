# GeneRaptor — environment template
#
# Copy to `.env` and fill in only what you need:
#   cp .env.example .env
#
# Every value below is intentionally EMPTY — GeneRaptor starts with zero
# configuration (local SQLite + one-time token). Never commit a filled-in .env.
#
# Only variables that the shipped code actually reads are listed here.

# ─────────────────────────────────────────────────────────────────────────
# LLM provider — RouterAI (OpenAI-compatible API)
# Providers other than RouterAI (OpenRouter / Ollama / custom) are configured
# in the UI (Settings → Providers) and stored in the local database.
# ─────────────────────────────────────────────────────────────────────────
# API key of the provider (required for generation).
ROUTERAI_API_KEY=
# API endpoint (default: the public RouterAI endpoint).
ROUTERAI_ENDPOINT=
# Model per tier: critical / generation / standard / cover.
ROUTERAI_MODEL_CRITICAL=
ROUTERAI_MODEL_GENERATION=
ROUTERAI_MODEL_STANDARD=
# Streaming responses (on/off).
ROUTERAI_STREAM=
# Disable "thinking" blocks for reasoning models (on/off).
ROUTERAI_DISABLE_THINKING=
# Retry / timeout budgets (milliseconds unless noted).
ROUTERAI_MAX_RETRIES=
ROUTERAI_TIMEOUT_MS=
ROUTERAI_IMAGE_TIMEOUT_MS=
# Fallback chain across tiers when the primary model fails (on/off).
ROUTERAI_FALLBACK_CHAIN=
# Cost control, rubles per 1000 tokens (used by the budget guard).
ROUTERAI_COST_INPUT_PER_1K=
ROUTERAI_COST_OUTPUT_PER_1K=
ROUTERAI_COST_HARD_MULTIPLIER=

# ─────────────────────────────────────────────────────────────────────────
# External web search (optional — the agent pipeline works without any key)
# ─────────────────────────────────────────────────────────────────────────
# Backend selection: auto (default) | tavily | tavily-keyless | serper |
#                   yandex | wikipedia | wikidata | duckduckgo.
#   auto          — the configured backends first (tavily → serper), then the
#                   keyless safety net: tavily-keyless → wikipedia → wikidata;
#   tavily        — Tavily with your key (needs GENERAPTOR_TAVILY_API_KEY);
#   tavily-keyless— Tavily keyless mode (no key, no account, rate-limited);
#   serper        — Serper.dev (free tier), needs GENERAPTOR_SERPER_API_KEY;
#   yandex        — Yandex Search API (paid), needs GENERAPTOR_YANDEX_API_KEY;
#   wikipedia     — MediaWiki Action API (keyless, official);
#   wikidata      — Wikidata Action API (keyless, official);
#   duckduckgo    — UNOFFICIAL HTML scraping, opt-in only, off by default,
#                   best-effort, no captcha bypass.
# "auto" keeps the product working out of the box with zero keys.
GENERAPTOR_SEARCH_BACKEND=
# Interface language of the search requests: ru (default) | en.
GENERAPTOR_SEARCH_LANG=
# Search request timeout, milliseconds (default 12000).
GENERAPTOR_SEARCH_TIMEOUT_MS=
# Tavily API key (optional). Sent ONLY to the canonical Tavily endpoint.
# The keyless mode needs no key at all.
GENERAPTOR_TAVILY_API_KEY=
# Serper.dev API key (optional). Sent ONLY to the canonical Serper.dev endpoint.
GENERAPTOR_SERPER_API_KEY=
# Yandex Search API key (optional, paid). Sent ONLY to the Yandex endpoint.
GENERAPTOR_YANDEX_API_KEY=
# Yandex Search endpoints (operator override; the key follows this endpoint).
YANDEX_SEARCH_ENDPOINT=
YANDEX_OPERATION_ENDPOINT=
# Legacy Yandex key variable — still read as a fallback of GENERAPTOR_YANDEX_API_KEY.
YANDEX_SEARCH_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Generation pipeline
# ─────────────────────────────────────────────────────────────────────────
# Consensus (fact cross-check) stage.
CONSENSUS_MODEL=
CONSENSUS_MAX_ROUNDS=
CONSENSUS_MIN_FACTS=
CONSENSUS_MIN_SUPPORT=
# Chunking of the source material.
CHUNK_SECTION_SIZE=
CHUNK_THRESHOLD=
SECTION_MAX_TOKENS=
# Quality control.
MAX_QUALITY_RETRIES=
# Post-check policy: report (default — report only) | enforce (a failed verdict
# sends the article to needs_review instead of ready).
POSTCHECK_MODE=
# Wall-clock / attempt budgets for one generation run.
GENERATION_WALL_CLOCK_MS=
GENERATION_MAX_ATTEMPTS=

# ─────────────────────────────────────────────────────────────────────────
# Access gate and tokens
# ─────────────────────────────────────────────────────────────────────────
# Disable the access gate completely — the app then starts WITHOUT a token
# and prints a loud warning. Only for single-user local machines.
ACCESS_GATE_DISABLED=
# HMAC key used to sign the access-gate cookies.
ACCESS_GATE_HMAC_KEY=
# Secret used to sign sessions (JWT).
JWT_SECRET=
# Fixed token instead of the one-time startup token (reusable).
GENERAPTOR_TOKEN=
# Lifetime of the one-time startup token (session | 24h | 7d | 30d).
GENERAPTOR_TOKEN_TTL=
# One-time startup token — generated by the launcher on every start.
# You never have to set this by hand.
GENERAPTOR_STARTUP_TOKEN=

# ─────────────────────────────────────────────────────────────────────────
# Runtime, network and data
# ─────────────────────────────────────────────────────────────────────────
# Directory for the local SQLite database, the provider key file and the cover
# binaries (default: ~/.generaptor). The CLI flag --data-dir overrides it.
# The launcher resolves the value ONCE and exports it to every child process as
# an ABSOLUTE path, so the server, the in-process worker and the cover store all
# share ONE directory (a relative value is resolved against the launcher's cwd).
# Keep it private: it holds the encrypted provider keys. The directory is
# created 0700 and the files 0600 on POSIX; on Windows the NTFS ACLs are the
# boundary, and a path outside your user profile triggers a [Data] WARNING.
GENERAPTOR_DATA_DIR=
# Full database URL. Normally derived from GENERAPTOR_DATA_DIR; set it only
# to point GeneRaptor at a specific SQLite file.
DATABASE_URL=
# Interface the API binds to (default: 127.0.0.1 — loopback only).
GENERAPTOR_HOST=
# Allow private/LAN provider addresses for the custom/ollama providers —
# OFF by default; enabling it widens the outbound attack surface.
GENERAPTOR_ALLOW_PRIVATE_NETWORK=
# Port of the API server (dev mode only; the packaged app uses --port).
GENERAPTOR_API_PORT=
# Path to a JSON file with the sites of this deployment (own-site registry).
# Empty by default: GeneRaptor ships no sites, so every research result stays
# external evidence. See server/source-registry.mjs for the file format.
GENERAPTOR_SOURCE_REGISTRY=
# Port of the Vite dev server (dev mode only).
PORT=
# Allowed browser origin for the API. This is the ONLY value echoed in
# Access-Control-Allow-Origin — the reading surface with cookies is never
# widened. In the dev topology the launcher also accepts the OTHER loopback
# spelling of the UI origin (127.0.0.1 <-> localhost, same port) in the Origin
# guard, so DELETE/POST work whichever spelling you opened. That alias is NOT
# configured here: the launcher passes it to the API child as the argv flag
# --dev-ui-origin <origin>, and only when it starts Vite itself. There is no
# environment variable for it (nothing can be inherited), and NODE_ENV takes no
# part in the decision. Packaged and --api-only runs get no alias at all.
CORS_ORIGIN=
# Secure flag for auth cookies (on/off) — set when serving over HTTPS.
COOKIE_SECURE=
# Production mode: the API serves the built frontend from dist/.
# NOTE: this does NOT decide the dev Origin alias — the launcher's topology
# does (see CORS_ORIGIN above). A dev run with NODE_ENV=production still gets
# the alias, and the server logs the mismatch as an [Origin] WARNING.
NODE_ENV=

# ─────────────────────────────────────────────────────────────────────────
# Frontend (build-time variables)
# ─────────────────────────────────────────────────────────────────────────
# WebSocket URL used by the progress feed (default: the page origin).
VITE_WS_BASE_URL=
